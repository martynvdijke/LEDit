# LEDit auth
LEDIT_ADMIN_PASSWORD=changeme
# LEDIT_AUTH_DISABLE=true

# OIDC SSO via Authelia (add-authelia-oidc). Keep disabled until verified.
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://authelia.vandijke.xyz
OIDC_CLIENT_ID=ledit
# Secret via file (preferred) — never commit the value.
OIDC_CLIENT_SECRET_FILE=/run/secrets/ledit_oidc_secret
# OIDC_CLIENT_SECRET=only-for-local-dev
OIDC_REDIRECT_URL=https://ledit.vandijke.xyz/api/auth/oidc/callback
OIDC_SCOPES=openid email profile groups
