<div class="layout layout--col layout--stretch gap">
  <div class="grid grid--cols-2">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--small">{{ system.cpu_cores }} cores</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--small">Mem - {{ system.memory }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--small">Load - {{ system.load }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--small">Shown - {{ analytics.total_displays }}</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image image--contain" src="{{ trml.plugin_settings.custom_fields_values.url }}/static/pwa/icon.svg">
  <span class="title">LEDit</span>
</div>
