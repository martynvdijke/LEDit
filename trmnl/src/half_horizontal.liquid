<div class="columns layout--stretch">
  <div class="column">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--medium">{{ system.cpu_cores }} cores</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--small">Mem - {{ system.memory }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--small">Load - {{ system.load }}</span>
      </div>
    </div>
  </div>
  <div class="column">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--medium">{{ analytics.total_displays }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--small">Uptime - {{ analytics.uptime }}</span>
      </div>
    </div>
    {% for stat in analytics.by_source %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--small">{{ stat[0] }} - {{ stat[1] }}</span>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <img class="image image--contain" src="{{ trml.plugin_settings.custom_fields_values.url }}/static/pwa/icon.svg">
  <span class="title">LEDit Stats</span>
</div>
